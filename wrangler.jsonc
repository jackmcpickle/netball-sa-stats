{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "netball-stats",
    "workers_dev": true,
    "preview_urls": true,
    "compatibility_date": "2026-08-07",
    "compatibility_flags": ["nodejs_compat"],
    "main": "@tanstack/react-start/server-entry",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "netball-stats",
            "database_id": "901da6ea-c57d-4529-915e-2d1718186efa",
            "migrations_dir": "drizzle",
        },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
    "cache": {
        "enabled": true,
    },
}
