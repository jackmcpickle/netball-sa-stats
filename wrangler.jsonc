{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "netball-stats",
    "workers_dev": true,
    "preview_urls": true,
    "compatibility_date": "2026-08-07",
    "compatibility_flags": ["nodejs_compat"],
    "main": "src/worker.ts",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "netball-stats",
            "database_id": "901da6ea-c57d-4529-915e-2d1718186efa",
            "migrations_dir": "drizzle",
        },
    ],
    "r2_buckets": [
        {
            "binding": "PLAYHQ_RAW",
            "bucket_name": "netball-stats-playhq-raw",
        },
    ],
    "workflows": [
        {
            "name": "playhq-import",
            "binding": "PLAYHQ_IMPORT",
            "class_name": "PlayHqImportWorkflow",
        },
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true,
        },
        "traces": {
            "enabled": true,
            "persist": true,
            "head_sampling_rate": 1,
        },
    },
    "cache": {
        "enabled": true,
    },
}
